---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/ui/Container.astro';
import Heading from '@components/ui/Heading.astro';
import Text from '@components/ui/Text.astro';
import Button from '@components/ui/Button.astro';
import Prose from '@components/ui/Prose.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const externalUrl = project.data.externalUrl || project.data.url;

const screenshotImports = import.meta.glob<{ default: ImageMetadata }>('/src/assets/screenshots/*.jpg', { eager: true });
const screenshot = screenshotImports[`/src/assets/screenshots/${project.data.slug}.jpg`]?.default;

const initials = project.data.title
  .split(/\s+/)
  .slice(0, 2)
  .map((w) => w[0])
  .join('')
  .toUpperCase();
---

<BaseLayout
  title={project.data.title}
  description={project.data.description}
>
  <article>
    <!-- Hero case study -->
    <section class="border-b border-border bg-background-secondary py-32 pt-48">
      <Container class="max-w-4xl">
        <p class="eyebrow mb-4">{project.data.category}</p>
        <Heading as="h1" size="1" class="mt-4">
          {project.data.title}
        </Heading>
        <Text variant="lead" class="mt-6">
          {project.data.longDescription || project.data.description}
        </Text>

        {
          project.data.services.length > 0 && (
            <div class="mt-8 flex flex-wrap gap-2">
              {project.data.services.map((service) => (
                <span class="rounded-full border border-border bg-surface px-3 py-1 text-xs font-medium text-text-secondary">
                  {service}
                </span>
              ))}
            </div>
          )
        }

        <div class="mt-10 flex flex-wrap gap-4">
          <Button href={externalUrl} variant="primary">
            Visitar proyecto
            <svg
              class="ml-2 h-4 w-4"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <polyline points="15 3 21 3 21 9" />
              <line x1="10" y1="14" x2="21" y2="3" />
            </svg>
          </Button>
          <Button href="/work" variant="secondary">
            ← Volver a proyectos
          </Button>
        </div>
      </Container>
    </section>

    <!-- Screenshot hero -->
    <section class="bg-background py-12">
      <Container class="max-w-5xl">
        <div class="aspect-[16/9] overflow-hidden rounded-xl border border-border bg-background-tertiary shadow-lg">
          {
            screenshot ? (
              <Image
                src={screenshot}
                alt={`Vista principal de ${project.data.title}`}
                width={1200}
                height={675}
                formats={['avif', 'webp', 'jpg']}
                quality={85}
                loading="eager"
                decoding="sync"
                fetchpriority="high"
                class="h-full w-full object-cover"
              />
            ) : (
              <div class="flex h-full w-full flex-col items-center justify-center bg-gradient-to-br from-deep-blue to-deep-blue-secondary p-6 text-center">
                <span class="font-display text-5xl font-bold text-text-inverted md:text-6xl">{initials}</span>
                <span class="mt-3 text-slate-400">{project.data.category}</span>
              </div>
            )
          }
        </div>
      </Container>
    </section>

    <!-- Case study body -->
    <section class="bg-background py-16">
      <Container class="max-w-3xl">
        <Prose>
          <Content />
        </Prose>

        <!-- Metadata grid -->
        <div class="mt-16 grid gap-6 border-t border-border pt-12 sm:grid-cols-2">
          {
            project.data.technologies && project.data.technologies.length > 0 && (
              <div>
                <h3 class="font-display text-sm font-semibold uppercase tracking-wider text-text-tertiary">Tecnologías</h3>
                <p class="mt-2 text-text-secondary">{project.data.technologies.join(' · ')}</p>
              </div>
            )
          }
          {
            project.data.year && (
              <div>
                <h3 class="font-display text-sm font-semibold uppercase tracking-wider text-text-tertiary">Año</h3>
                <p class="mt-2 text-text-secondary">{project.data.year}</p>
              </div>
            )
          }
          {
            project.data.status && (
              <div>
                <h3 class="font-display text-sm font-semibold uppercase tracking-wider text-text-tertiary">Estado</h3>
                <p class="mt-2 text-text-secondary">
                  {project.data.status === 'active' ? 'En producción' : project.data.status === 'in-development' ? 'En desarrollo' : 'Archivado'}
                </p>
              </div>
            )
          }
          <div>
            <h3 class="font-display text-sm font-semibold uppercase tracking-wider text-text-tertiary">URL</h3>
            <a href={externalUrl} target="_blank" rel="noopener noreferrer" class="mt-2 inline-block text-accent-hover hover:underline">
              {externalUrl.replace(/^https?:\/\//, '')}
            </a>
          </div>
        </div>
      </Container>
    </section>

    <!-- CTA -->
    <section class="border-t border-border bg-background-secondary py-16">
      <Container class="max-w-3xl text-center">
        <Heading as="h2" size="3">¿Tienes un proyecto similar?</Heading>
        <Text variant="lead" class="mt-4">
          Conversemos sobre cómo transformar tu proceso en un sistema digital.
        </Text>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <Button href="/contact" variant="primary">Conversemos</Button>
          <Button href="/work" variant="secondary">Ver otros proyectos</Button>
        </div>
      </Container>
    </section>
  </article>
</BaseLayout>
