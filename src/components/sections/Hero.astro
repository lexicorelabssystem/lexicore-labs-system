---
import Container from '@components/ui/Container.astro';
import Button from '@components/ui/Button.astro';
import { SITE } from '@data/site';
---

<section class="relative overflow-hidden border-b border-border bg-background pt-32 pb-20 md:pt-40 md:pb-28">
  <!-- Subtle grid background -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute inset-0 bg-[linear-gradient(rgba(15,23,42,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(15,23,42,0.03)_1px,transparent_1px)] bg-[size:64px_64px]"></div>
    <div class="absolute right-0 top-0 h-full w-1/3 bg-gradient-to-l from-accent-light/40 to-transparent"></div>
  </div>

  <Container class="relative">
    <div class="max-w-4xl">
      <p class="eyebrow mb-6">{SITE.name}</p>
      <h1 class="font-display text-4xl font-bold tracking-tight text-text-primary sm:text-5xl md:text-6xl lg:text-7xl">
        Del proceso al producto digital.
      </h1>
      <p class="mt-8 max-w-2xl text-lg leading-relaxed text-text-secondary md:text-xl">
        Diseñamos software, plataformas e infraestructura capaces de transformar procesos reales en sistemas digitales claros, seguros y escalables.
      </p>

      <div class="mt-10 flex flex-wrap gap-4">
        <Button href="/work" variant="primary">Explorar proyectos</Button>
        <Button href="/contact" variant="secondary">Conversemos</Button>
      </div>

      <ul class="mt-12 flex flex-wrap gap-3">
        <li class="rounded-full border border-border bg-surface px-4 py-1.5 text-sm text-text-secondary">Software a medida</li>
        <li class="rounded-full border border-border bg-surface px-4 py-1.5 text-sm text-text-secondary">Plataformas digitales</li>
        <li class="rounded-full border border-border bg-surface px-4 py-1.5 text-sm text-text-secondary">Cloud infrastructure</li>
        <li class="rounded-full border border-border bg-surface px-4 py-1.5 text-sm text-text-secondary">Paperless systems</li>
      </ul>
    </div>

    <!-- Visual metaphor: document → data → nodes -->
    <div class="absolute right-0 top-1/2 hidden -translate-y-1/2 lg:block xl:right-12" aria-hidden="true">
      <svg width="360" height="360" viewBox="0 0 360 360" fill="none" xmlns="http://www.w3.org/2000/svg" class="opacity-80">
        <!-- Document outline -->
        <rect x="40" y="60" width="120" height="160" rx="6" stroke="#0f172a" stroke-width="1.5" stroke-opacity="0.18" />
        <line x1="60" y1="100" x2="140" y2="100" stroke="#0f172a" stroke-width="1.5" stroke-opacity="0.12" />
        <line x1="60" y1="120" x2="140" y2="120" stroke="#0f172a" stroke-width="1.5" stroke-opacity="0.12" />
        <line x1="60" y1="140" x2="110" y2="140" stroke="#0f172a" stroke-width="1.5" stroke-opacity="0.12" />

        <!-- Arrow -->
        <path d="M170 140 L210 140 M200 134 L210 140 L200 146" stroke="#0ea5e9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />

        <!-- Data nodes -->
        <circle cx="250" cy="100" r="8" fill="#e0f2fe" stroke="#0ea5e9" stroke-width="2" />
        <circle cx="290" cy="140" r="8" fill="#e0f2fe" stroke="#0ea5e9" stroke-width="2" />
        <circle cx="250" cy="180" r="8" fill="#e0f2fe" stroke="#0ea5e9" stroke-width="2" />
        <circle cx="290" cy="220" r="8" fill="#e0f2fe" stroke="#0ea5e9" stroke-width="2" />
        <line x1="250" y1="108" x2="290" y2="132" stroke="#0ea5e9" stroke-width="1.5" stroke-opacity="0.5" />
        <line x1="290" y1="148" x2="250" y2="172" stroke="#0ea5e9" stroke-width="1.5" stroke-opacity="0.5" />
        <line x1="250" y1="188" x2="290" y2="212" stroke="#0ea5e9" stroke-width="1.5" stroke-opacity="0.5" />

        <!-- Server / architecture block -->
        <rect x="210" y="260" width="100" height="60" rx="6" fill="#0f172a" />
        <rect x="225" y="275" width="70" height="4" rx="2" fill="#f8fafc" fill-opacity="0.4" />
        <rect x="225" y="285" width="50" height="4" rx="2" fill="#f8fafc" fill-opacity="0.4" />
        <rect x="225" y="295" width="60" height="4" rx="2" fill="#f8fafc" fill-opacity="0.4" />

        <!-- Connection -->
        <path d="M270 228 L270 260" stroke="#0ea5e9" stroke-width="1.5" stroke-dasharray="4 4" stroke-opacity="0.6" />
      </svg>
    </div>
  </Container>
</section>
