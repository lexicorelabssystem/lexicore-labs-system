---
import Container from '@components/ui/Container.astro';
import Heading from '@components/ui/Heading.astro';
---

<section class="section border-y border-border bg-background">
  <Container class="text-center">
    <p class="eyebrow mb-6">FROM STRATEGY TO PRODUCTION.</p>
    <Heading as="h2" size="2" class="mx-auto max-w-4xl">
      Diseñamos la solución.<br />
      Construimos la arquitectura.<br />
      Desarrollamos el producto.<br />
      Lo llevamos a producción.
    </Heading>
  </Container>
</section>
