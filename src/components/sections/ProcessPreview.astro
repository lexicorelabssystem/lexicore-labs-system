---
import { getCollection } from 'astro:content';
import Container from '@components/ui/Container.astro';
import Heading from '@components/ui/Heading.astro';
import Text from '@components/ui/Text.astro';

const steps = await getCollection('process');
const sortedSteps = steps.sort((a, b) => a.data.order - b.data.order);
---

<section class="section bg-background">
  <Container>
    <div class="mb-16 max-w-3xl">
      <p class="eyebrow mb-4">Process</p>
      <Heading as="h2" size="2">De la necesidad al sistema en producción.</Heading>
      <Text variant="lead" class="mt-6">
        No terminamos cuando la interfaz está lista. Diseñamos pensando en cómo funcionará el producto cuando esté realmente en producción.
      </Text>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        sortedSteps.map((step) => (
          <a
            href="/process"
            class="group relative rounded-lg border border-border bg-surface p-6 transition-all hover:-translate-y-1 hover:border-border-strong hover:shadow-md focus:outline-none"
          >
            <span class="font-mono text-xs text-text-tertiary">{String(step.data.order).padStart(2, '0')}</span>
            <h3 class="mt-3 font-display text-lg font-semibold text-text-primary transition-colors group-hover:text-accent-hover">
              {step.data.title}
            </h3>
            <p class="mt-2 text-sm text-text-secondary">{step.data.description}</p>
          </a>
        ))
      }
    </div>
  </Container>
</section>
