---
import { getCollection } from 'astro:content';
import Container from '@components/ui/Container.astro';
import Heading from '@components/ui/Heading.astro';
import Text from '@components/ui/Text.astro';

const capabilities = await getCollection('capabilities');
const sortedCapabilities = capabilities.sort((a, b) => a.data.order - b.data.order);
---

<section class="section bg-background">
  <Container>
    <div class="mb-16 max-w-3xl">
      <p class="eyebrow mb-4">Capabilities</p>
      <Heading as="h2" size="2">Capacidad real en múltiples capas.</Heading>
      <Text variant="lead" class="mt-6">
        Trabajamos desde la definición del producto hasta la operación en producción. No una colección de iconos: una presentación editorial de lo que sabemos construir.
      </Text>
    </div>

    <div class="grid gap-px border border-border bg-border sm:grid-cols-2 lg:grid-cols-3">
      {
        sortedCapabilities.map((capability) => (
          <a
            href="/capabilities"
            class="group block bg-surface p-8 transition-colors hover:bg-background-secondary focus:outline-none"
          >
            <p class="font-mono text-xs text-text-tertiary">{String(capability.data.order).padStart(2, '0')}</p>
            <h3 class="mt-3 font-display text-xl font-semibold text-text-primary transition-colors group-hover:text-accent-hover">
              {capability.data.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-text-secondary">{capability.data.shortDescription}</p>
          </a>
        ))
      }
    </div>
  </Container>
</section>
