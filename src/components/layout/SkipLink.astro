---
interface Props {
  target?: string;
  label?: string;
}

const { target = '#main', label = 'Saltar al contenido principal' } = Astro.props;
---

<a
  href={target}
  class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-sm focus:bg-accent focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-background"
>
  {label}
</a>
