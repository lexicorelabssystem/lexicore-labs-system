---
import Container from '@components/ui/Container.astro';
import { SITE, NAVIGATION, SOCIAL } from '@data/site';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-border bg-background-secondary">
  <Container class="py-16">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <a href="/" class="flex items-center gap-3 font-display text-xl font-semibold tracking-tight text-text-primary">
          <img src="/logo.svg" alt="" width="80" height="100" class="h-10 w-auto" aria-hidden="true" />
          <span>{SITE.name}</span>
        </a>
        <p class="mt-4 max-w-sm text-text-secondary">
          Software Engineering · Digital Products · Cloud Infrastructure · Paperless Systems
        </p>
      </div>

      <div class="lg:col-span-3">
        <h2 class="font-display text-sm font-semibold uppercase tracking-wider text-text-tertiary">
          Navegación
        </h2>
        <ul class="mt-4 space-y-3">
          {
            NAVIGATION.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-text-secondary transition-colors hover:text-text-primary"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lg:col-span-2">
        <h2 class="font-display text-sm font-semibold uppercase tracking-wider text-text-tertiary">
          Contacto
        </h2>
        <ul class="mt-4 space-y-3">
          <li>
            <a
              href={`mailto:${SITE.email}`}
              class="text-text-secondary transition-colors hover:text-text-primary"
            >
              {SITE.email}
            </a>
          </li>
          <li>
            <a
              href={SITE.whatsappLink}
              target="_blank"
              rel="noopener noreferrer"
              class="text-text-secondary transition-colors hover:text-text-primary"
            >
              {SITE.whatsapp}
            </a>
          </li>
        </ul>
      </div>

      <div class="lg:col-span-2">
        <h2 class="font-display text-sm font-semibold uppercase tracking-wider text-text-tertiary">
          Legal
        </h2>
        <ul class="mt-4 space-y-3">
          {
            SOCIAL.map((item) => (
              <li>
                <a
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-text-secondary transition-colors hover:text-text-primary"
                >
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-16 flex flex-col items-start justify-between gap-4 border-t border-border pt-8 sm:flex-row sm:items-center">
      <p class="text-sm text-text-tertiary">
        © {currentYear} {SITE.name}. Todos los derechos reservados.
      </p>
      <p class="text-sm text-text-tertiary">
        Menos papel. Más sistema.
      </p>
    </div>
  </Container>
</footer>
