---
import Container from '@components/ui/Container.astro';

const currentPath = Astro.url.pathname;

const items = [
  { href: '/inventacore', label: 'InventaCore' },
  { href: '/inventacore/funcionalidades', label: 'Funcionalidades' },
  { href: '/inventacore/pantallas', label: 'Pantallas' },
  { href: '/inventacore/nosotros-lo-usamos', label: 'Nosotros lo usamos' },
];
---

<nav aria-label="InventaCore" class="border-b border-border bg-background-secondary">
  <Container>
    <ul class="flex gap-6 overflow-x-auto py-4 text-sm">
      {
        items.map((item) => {
          const isActive = currentPath === item.href || currentPath.startsWith(`${item.href}/`);
          return (
            <li class="shrink-0">
              <a
                href={item.href}
                class={`whitespace-nowrap transition-colors ${
                  isActive
                    ? 'font-medium text-text-primary'
                    : 'text-text-secondary hover:text-text-primary'
                }`}
                aria-current={isActive ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </Container>
</nav>
