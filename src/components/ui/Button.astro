---
import { cn } from '@lib/utils';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'inverted';
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  ariaLabel?: string;
}

const { href, variant = 'primary', class: className, type = 'button', ariaLabel } = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-sm px-5 py-3 text-sm font-medium transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background';

const variants = {
  primary: 'bg-deep-blue text-text-inverted hover:bg-deep-blue-secondary shadow-sm',
  secondary:
    'border border-border bg-surface text-text-primary hover:border-border-strong hover:bg-background-secondary',
  ghost: 'text-text-primary hover:text-accent-hover',
  inverted: 'bg-text-inverted text-deep-blue hover:bg-background-secondary',
} as const;

const classes = cn(base, variants[variant], className);
---

{
  href ? (
    <a href={href} class={classes} aria-label={ariaLabel}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} aria-label={ariaLabel}>
      <slot />
    </button>
  )
}
