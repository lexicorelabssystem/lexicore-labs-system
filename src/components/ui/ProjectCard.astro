---
import { Image } from 'astro:assets';
import { cn } from '@lib/utils';

interface Props {
  slug: string;
  title: string;
  category: string;
  description: string;
  imageSrc?: ImageMetadata;
  size?: 'large' | 'medium';
  priority?: boolean;
}

const { slug, title, category, description, imageSrc, size = 'medium', priority = false } = Astro.props;
const span = size === 'large' ? 'lg:col-span-7' : 'lg:col-span-5';
const initials = title
  .split(/\s+/)
  .slice(0, 2)
  .map((w) => w[0])
  .join('')
  .toUpperCase();
---

<article class={cn('group', span)}>
  <a href={`/work/${slug}`} class="block focus:outline-none">
    <div class="relative aspect-[16/10] overflow-hidden rounded-lg border border-border bg-background-tertiary">
      {
        imageSrc ? (
          <Image
            src={imageSrc}
            alt={`Captura del proyecto ${title}`}
            width={800}
            height={500}
            formats={['avif', 'webp', 'jpg']}
            quality={85}
            loading={priority ? 'eager' : 'lazy'}
            decoding={priority ? 'sync' : 'async'}
            fetchpriority={priority ? 'high' : 'auto'}
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
          />
        ) : (
          <div class="flex h-full w-full flex-col items-center justify-center bg-gradient-to-br from-deep-blue to-deep-blue-secondary p-6 text-center">
            <span class="font-display text-3xl font-bold text-text-inverted md:text-4xl">{initials}</span>
            <span class="mt-2 text-sm text-slate-400">{category}</span>
          </div>
        )
      }
      <div class="absolute inset-0 bg-gradient-to-t from-deep-blue/60 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
      <div class="absolute bottom-4 left-4 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
        <span class="rounded-sm bg-accent px-3 py-1.5 text-sm font-medium text-text-inverted">Ver caso</span>
      </div>
    </div>
    <div class="mt-5">
      <p class="font-mono text-xs uppercase tracking-wider text-accent-hover">{category}</p>
      <h3 class="mt-2 font-display text-xl font-semibold text-text-primary transition-colors group-hover:text-accent-hover sm:text-2xl">
        {title}
      </h3>
      <p class="mt-2 text-sm text-text-secondary line-clamp-2">{description}</p>
    </div>
  </a>
</article>
