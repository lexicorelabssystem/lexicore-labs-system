---
import { cn } from '@lib/utils';

interface Props {
  as?: 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
  size?: HeadingSize;
  class?: string;
}

type HeadingSize = 'display' | '1' | '2' | '3' | '4';

const props: Props = Astro.props;
const { as: Tag = 'h2', size = '2', class: className } = props;

const sizes: Record<HeadingSize, string> = {
  display:
    'font-display text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl',
  '1': 'font-display text-3xl font-semibold tracking-tight sm:text-4xl md:text-5xl lg:text-6xl',
  '2': 'font-display text-2xl font-semibold tracking-tight sm:text-3xl md:text-4xl',
  '3': 'font-display text-xl font-semibold tracking-tight sm:text-2xl md:text-3xl',
  '4': 'font-display text-lg font-semibold tracking-tight sm:text-xl md:text-2xl',
};
---

<Tag class={cn(sizes[size], className)}>
  <slot />
</Tag>
